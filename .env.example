# Set these in your shell. ForgeFix does not auto-load .env files.
FORGEFIX_API_KEY=
FORGEFIX_MODEL=
FORGEFIX_API_URL=https://api.openai.com/v1/chat/completions
# Supply the actual rates for your chosen model; omitted rates mean unknown cost.
FORGEFIX_INPUT_USD_PER_MILLION=
FORGEFIX_OUTPUT_USD_PER_MILLION=

